# Development Environment Settings
# Copy this to .env to use these settings

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting (Development - Very Lenient)
DISABLE_RATE_LIMITING=false
DISABLE_LOGIN_RATE_LIMIT=true

# Database
DATABASE_URL=sqlite:///./taaskmaaster.db

# Security (Development - Change in production)
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=taaskmaaster-media
MINIO_SECURE=false

# Ports
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TaaskMaaster
NODE_ENV=development
