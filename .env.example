# =============================================================================
# TaaskMaaster Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed
# All variables have sensible defaults and are optional for development

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# Security Keys (Change these in production!)
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# =============================================================================
# Port Configuration (Optional - defaults to localhost only)
# =============================================================================
# BACKEND_PORT=127.0.0.1:8000
# FRONTEND_PORT=127.0.0.1:3000

# =============================================================================
# Database Configuration
# =============================================================================
# Default: SQLite (file-based, no setup required)
DATABASE_URL=sqlite:///./taaskmaaster.db

# For PostgreSQL (uncomment and configure):
# DATABASE_URL=postgresql://taaskmaaster:password@postgres:5432/taaskmaaster

# =============================================================================
# Redis Configuration (Internal - no external access needed)
# =============================================================================
# REDIS_URL=redis://redis:6379

# =============================================================================
# MinIO Configuration (Internal - no external access needed)
# =============================================================================
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_BUCKET_NAME=taaskmaaster-media
# MINIO_SECURE=false

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Configuration (Optional)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TaaskMaaster

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-here
